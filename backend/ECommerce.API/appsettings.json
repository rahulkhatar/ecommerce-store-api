{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // Overridden per-environment: appsettings.Development.json points at a
    // local SQL Server install; production supplies its own (BigRock-hosted
    // SQL Server) via the ConnectionStrings__DefaultConnection environment
    // variable on whatever host runs the API (see the deploy notes).
    "DefaultConnection": "Server=localhost;Database=ECommerceDB;Trusted_Connection=True;TrustServerCertificate=true;"
  },
  "JWT": {
    "Secret": "your-super-secret-jwt-key-change-in-production-at-least-32-characters",
    "Issuer": "http://localhost:5000",
    "Audience": "ecommerce-app",
    "ExpiryMinutes": 60
  },
  "CorsOrigins": "http://localhost:5173,http://localhost:3000",
  "App": {
    "FrontendBaseUrl": "http://localhost:5173"
  },
  "Razorpay": {
    "KeyId": "your_razorpay_key_id",
    "KeySecret": "your_razorpay_key_secret"
  },
  "PayPal": {
    "BaseUrl": "https://api-m.sandbox.paypal.com",
    "ClientId": "your_paypal_client_id",
    "ClientSecret": "your_paypal_client_secret"
  },
  // "your-openai-api-key" is a literal placeholder, not a null the OpenAI
  // client would reject up front - without a real key here (or via
  // appsettings.Production.json / the OpenAI__ApiKey env var), every chat
  // request fails OpenAI's auth check and the assistant returns a generic
  // 500. gpt-4o-mini is the recommended default: far cheaper than gpt-4 and
  // plenty capable for product search/order lookup/small talk.
  "OpenAI": {
    "ApiKey": "your-openai-api-key",
    "Model": "gpt-4o-mini"
  },
  // Cloudflare R2 (S3-compatible object storage) for product image uploads.
  // Left blank here on purpose: whenever R2:AccessKeyId is unset (as in
  // local dev), AddInfrastructureServices falls back to local-disk storage
  // instead. Production supplies real values via environment variables
  // (R2__AccountId, R2__AccessKeyId, R2__SecretAccessKey, R2__BucketName,
  // R2__PublicUrl) on whatever host runs the API - never put real R2
  // credentials in this file.
  "R2": {
    "AccountId": "",
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "BucketName": "",
    "PublicUrl": ""
  },
  // Used to send replies to Inquiries (SmtpEmailService reads only these six
  // keys - no provider-specific code, so ANY SMTP provider works here: a
  // BigRock/cPanel mailbox, GoDaddy Workspace Email, Gmail, Outlook, or any
  // other mail server. Left blank here on purpose - real values go either in
  // appsettings.Production.json (gitignored, never committed) or as
  // environment variables (Smtp__Host, Smtp__Port, Smtp__Username,
  // Smtp__Password, Smtp__FromEmail, Smtp__FromName) on whatever host runs
  // the API - never put real SMTP credentials in this file.
  //
  // What each value is, regardless of provider:
  //   Host     - the provider's outgoing/SMTP server address
  //              (e.g. mail.yourdomain.com for BigRock/cPanel,
  //              smtpout.secureserver.net for GoDaddy, smtp.gmail.com for Gmail)
  //   Port     - usually 587 (STARTTLS); some providers use 465 instead
  //   Username - usually the full mailbox address (you@yourdomain.com)
  //   Password - the mailbox's own password, EXCEPT Gmail: Gmail requires a
  //              16-character "App Password" (Google Account > Security >
  //              App Passwords) instead of your normal Gmail password
  //   FromEmail - the address replies appear to come from (usually = Username)
  //   FromName  - the display name shown to the recipient
  "Smtp": {
    "Host": "",
    "Port": "587",
    "Username": "",
    "Password": "",
    "FromEmail": "",
    "FromName": "ecommerce.store"
  }
}
