# ============================================
# DATABASE CONFIGURATION
# ============================================
# DB_SERVER/DB_PORT below are for container-to-container traffic (api -> mssql
# over the internal Docker network) and match docker-compose.yml's service
# name + container port — leave as-is. From the HOST machine (e.g. a local
# sqlcmd/GUI client), connect to localhost:14333 instead, since the compose
# file maps the container's 1433 to host port 14333 to avoid clashing with
# other SQL Server instances already running locally.
DB_SERVER=mssql
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=Reset@789
DB_NAME=ECommerceDB
CONNECTION_STRING=Server=mssql;Database=ECommerceDB;User Id=sa;Password=Reset@789;Encrypt=false;TrustServerCertificate=true;

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-at-least-32-characters-long-for-security
JWT_ISSUER=http://localhost:5000
JWT_AUDIENCE=ecommerce-app
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7

# ============================================
# OPENAI CONFIGURATION
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.7

# ============================================
# STRIPE PAYMENT CONFIGURATION
# ============================================
STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ============================================
# RAZORPAY CONFIGURATION (ALTERNATIVE)
# ============================================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ============================================
# EMAIL CONFIGURATION
# ============================================
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=noreply@ecommerce.com
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM_NAME=ECommerce Store

# ============================================
# REDIS CONFIGURATION (FOR CACHING)
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# ============================================
# APPLICATION CONFIGURATION
# ============================================
ENVIRONMENT=Development
LOG_LEVEL=Information
API_BASE_URL=http://localhost:5000
APP_NAME=ECommerce Store
APP_DESCRIPTION=Modern E-Commerce Platform

# ============================================
# FRONTEND CONFIGURATION
# ============================================
VITE_API_URL=http://localhost:5000
VITE_APP_NAME=ECommerce Store
VITE_APP_DESCRIPTION=Modern E-Commerce Platform
VITE_ENVIRONMENT=development

# ============================================
# AWS CONFIGURATION (OPTIONAL - FOR UPLOADS)
# ============================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=ecommerce-uploads

# ============================================
# SHIPPING INTEGRATION (OPTIONAL)
# ============================================
FEDEX_API_KEY=your_fedex_api_key
FEDEX_ACCOUNT_NUMBER=your_account_number
UPS_API_KEY=your_ups_api_key
DHL_API_KEY=your_dhl_api_key

# ============================================
# MONITORING & LOGGING
# ============================================
APPLICATION_INSIGHTS_KEY=your_app_insights_key
DATADOG_API_KEY=your_datadog_api_key
LOG_FILE_PATH=/var/log/ecommerce/

# ============================================
# ADMIN CREDENTIALS
# ============================================
ADMIN_EMAIL=admin@ecommerce.com
ADMIN_PASSWORD=Admin@123456
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_AI_FEATURES=true
ENABLE_RECOMMENDATIONS=true
ENABLE_CHATBOT=true
ENABLE_ANALYTICS=true
ENABLE_SOCIAL_LOGIN=false
ENABLE_BULK_UPLOAD=true

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_ENABLED=true

# ============================================
# DATA ENCRYPTION
# ============================================
ENCRYPTION_KEY=your-32-character-encryption-key-for-production
SALT_ROUNDS=11

# ============================================
# PAGINATION
# ============================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ============================================
# FILE UPLOAD
# ============================================
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx

# ============================================
# CACHE CONFIGURATION
# ============================================
CACHE_ENABLED=true
CACHE_DURATION_MINUTES=30
CACHE_KEY_PREFIX=ecommerce_

# ============================================
# BATCH PROCESSING
# ============================================
BATCH_SIZE=100
BATCH_PROCESSING_ENABLED=true

# ============================================
# SEARCH CONFIGURATION
# ============================================
ELASTICSEARCH_URL=http://elasticsearch:9200
FULL_TEXT_SEARCH_ENABLED=true

# ============================================
# AUDIT LOGGING
# ============================================
AUDIT_LOGGING_ENABLED=true
AUDIT_LOG_FILE=/var/log/ecommerce/audit.log

# ============================================
# BACKUP CONFIGURATION
# ============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/var/backups/ecommerce/

# ============================================
# PRODUCTION SETTINGS
# ============================================
USE_HTTPS=true
CERTIFICATE_PATH=/etc/nginx/ssl/certificate.crt
PRIVATE_KEY_PATH=/etc/nginx/ssl/private.key
